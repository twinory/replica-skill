        ],
        "css": "html.husk-app,html.husk-app body{background:#030303!important}html.husk-app ytmusic-mealbar-promo-renderer,html.husk-app ytmusic-popup-container{display:none!important}html.husk-app ytmusic-player-page{height:100vh!important}",
        "js": "document.documentElement.classList.add('husk-app');"
      },
      "player": {
        "js": "(()=>{if(window.__huskPlayer)return;window.__huskPlayer=1;const tick=()=>{try{const v=document.querySelector('video');const ad=document.querySelector('.ad-showing,.ad-interrupting');if(v&&ad){if(v.duration&&isFinite(v.duration)){v.currentTime=v.duration;}v.muted=true;}else if(v&&v.playbackRate===16){v.playbackRate=1;v.muted=false;}}catch(e){}};setInterval(tick,600);})();"
      },
      "notes": "Same account and library as YouTube. Playback continues in the background on Android."
