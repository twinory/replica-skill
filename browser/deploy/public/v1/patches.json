{
  "_comment": "Husk site patches. Same file is bundled in the app and served by the Cloudflare Worker at /v1/patches.json, so App Mode can be fixed without shipping a new binary. Selectors are CSS only. Scripts are guarded and must never throw or touch page data. Nothing here copies a site's code, assets or copy.",
  "version": 2,
  "updated": "2026-10-27",
  "sites": [
    {
      "id": "youtube",
      "name": "YouTube",
      "hosts": [
        "youtube.com",
        "m.youtube.com",
        "www.youtube.com",
        "youtu.be"
      ],
      "start": "https://m.youtube.com/",
      "featured": true,
      "icon": "play",
      "color": "#FF0033",
      "media": true,
      "cosmetic": [
        "ytm-promoted-sparkles-web-renderer",
        "ytm-companion-ad-renderer",
        "ytm-companion-slot",
        "ytm-app-promo",
        "ytm-mealbar-promo-renderer",
        "ytm-statement-banner-renderer",
        "ytm-upsell-dialog-renderer",
        "ytm-item-section-renderer[section-identifier=\"ads\"]",
        "ytd-display-ad-renderer",
        "ytd-promoted-sparkles-web-renderer",
        "ytd-ad-slot-renderer",
        "ytd-in-feed-ad-layout-renderer",
        "#masthead-ad",
        "#player-ads",
        ".ytp-ad-overlay-container",
        ".ytp-ad-text-overlay",
        ".ytp-ad-image-overlay"
      ],
      "appMode": {
        "hide": [
          ".mobile-promo",
          ".app-promo",
          "#app-promo",
          "ytm-app-promo",
          "ytm-mealbar-promo-renderer",
          "ytm-survey-shelf-renderer",
          "ytm-popup-container",
          "ytd-miniplayer"
        ],
        "css": "html.husk-app,html.husk-app body{background:#0f0f0f!important}html.husk-app ytm-app-promo,html.husk-app #app-promo,html.husk-app .mobile-promo,html.husk-app ytm-mealbar-promo-renderer{display:none!important}html.husk-app ytm-header-bar{position:sticky!important;top:0!important}html.husk-app #player-container-id{margin-top:0!important}html.husk-app .ytp-chrome-top{opacity:0!important}html.husk-app .ytp-chrome-top:hover{opacity:1!important}",
        "js": "document.documentElement.classList.add('husk-app');"
      },
      "player": {
        "js": "(()=>{if(window.__huskPlayer)return;window.__huskPlayer=1;const tick=()=>{try{const v=document.querySelector('video');if(!v)return;const ad=document.querySelector('.ad-showing,.ad-interrupting,.ytp-ad-player-overlay');if(ad){if(v.duration&&isFinite(v.duration)){v.currentTime=v.duration;}v.muted=true;v.playbackRate=16;const s=document.querySelector('.ytp-ad-skip-button,.ytp-skip-ad-button,.ytp-ad-skip-button-modern,.ytp-ad-overlay-close-button');if(s)s.click();}else if(v.playbackRate===16){v.playbackRate=1;v.muted=false;}}catch(e){}};setInterval(tick,500);})();"
      },
      "notes": "Loads the mobile site, which already has app-style bottom navigation. Sign-in is routed to the system browser because Google refuses its login page inside an embedded WebView. Ads inserted into the video stream itself cannot be removed by any browser, including this one."
    },
